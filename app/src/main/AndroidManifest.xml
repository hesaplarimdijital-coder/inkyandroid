<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No permissions: the stories are the user's own files, opened through the system's file
         picker, and nothing leaves the device.
         allowBackup: nothing of the app is backed up; the stories live where the user keeps them.
         enableOnBackInvokedCallback: the predictive Back gesture plays the kit's transitions. -->
    <application
        android:name=".InkyApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Inky">
        <!-- The activity as desktop-kit's README defines it: resizeableActivity and configChanges let
             DeX resize the window without restarting the activity, adjustResize ends the content
             above the on-screen keyboard. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|fontScale"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Opening an .ink file from another app (com.inkyandroid.storage). File managers
                 send .ink files under many types (none is registered for ink), so the filters
                 match by the path's extension with any type, and any file of unknown type;
                 ProjectStorage.openFile then refuses what is not text. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.ink" />
                <data android:pathPattern=".*\\..*\\.ink" />
                <data android:pathPattern=".*\\..*\\..*\\.ink" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.ink" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- Android 15+: the system's window menus (DeX, the taskbar) offer "New window" -->
            <property
                android:name="android.window.PROPERTY_SUPPORTS_MULTI_INSTANCE_SYSTEM_UI"
                android:value="true" />
        </activity>
    </application>
</manifest>
